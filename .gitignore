# =============================================================================
# Build outputs — never committed
# =============================================================================
# sdk/ is the migration target's output dir. The README inside it IS
# tracked so the directory's purpose is documented; everything else is
# regenerated by ./gradlew buildAll.
/sdk/
!/sdk/README.md

# Gradle per-project caches and build outputs across the whole tree.
**/build/
**/.gradle/
build-logic/.gradle/

# =============================================================================
# IDE — auto-imported from Gradle, nothing project-local to share
# =============================================================================
.idea/
*.iml
*.iws
*.ipr
out/

.vscode/
.fleet/

# =============================================================================
# Native build intermediates (CMake / MSVC / GCC / Clang)
# =============================================================================
**/cmake-build-*/
**/CMakeCache.txt
**/CMakeFiles/
**/CMakeUserPresets.json
**/*.o
**/*.a
**/*.obj
**/*.lib
**/*.exp
**/*.pdb
**/*.ilk

# =============================================================================
# Project-private instructions — not shared, never committed
# =============================================================================
/CLAUDE.md

# =============================================================================
# External read-only upstream reference (sibling directory, never tracked)
# =============================================================================
/jfx-master/

# =============================================================================
# Blink engine (skia-fx-webview) — isolated Chromium checkout workspace.
# Tens of GB, seeded by `./gradlew :javafx.web:seedChromium`. Never committed.
# (Override location via -PchromiumHome=; ignore the default here.)
# =============================================================================
/.chromium/

# =============================================================================
# JVM diagnostics, OS artifacts, logs, temp files
# =============================================================================
hs_err_pid*.log
replay_pid*.log
*.hprof
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*~

# =============================================================================
# Explicit allows
# =============================================================================
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradle/libs.versions.toml
/gradle/wrapper/gradle-wrapper.properties
/gradle/wrapper/gradle-wrapper.jar
/resume.md
/.claude/
/Reaseach /
/Research/
/graphify-out/
