# EditorConfig — consistent indentation / EOL / charset across editors.
# IntelliJ, VS Code, Eclipse, Vim, Emacs all honour this out of the box.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows shell wrappers
[*.{bat,cmd}]
end_of_line = crlf

# Gradle build scripts: 4-space (matches Java)
[*.{gradle,gradle.kts}]
indent_size = 4

# YAML / TOML: 2-space
[*.{yml,yaml,toml}]
indent_size = 2

# Markdown: keep trailing whitespace (line breaks within paragraphs)
[*.md]
trim_trailing_whitespace = false

# Native source: 4-space matches the Java side
[*.{c,cpp,h,hpp,cc,cxx,m,mm}]
indent_size = 4

# CMakeLists: 4-space, standard
[CMakeLists.txt]
indent_size = 4
[*.cmake]
indent_size = 4
