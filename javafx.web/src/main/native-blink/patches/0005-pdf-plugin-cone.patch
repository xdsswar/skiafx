index 5a9c4bd..ff947c7 100644
--- a/chrome/browser/resources/pdf/elements/viewer_zoom_toolbar.css
+++ b/chrome/browser/resources/pdf/elements/viewer_zoom_toolbar.css
@@ -36,8 +36,12 @@
   right: var(--button-position-offset);
 }
 
+/* skia-fx: the off-screen (OSR) print preview does not reliably deliver the
+   bottom-left mouse-move "reveal" that ToolbarManager relies on, so the zoom
+   toolbar never faded in. Keep the zoom buttons always visible (persistent),
+   like a normal toolbar, instead of reveal-on-hover. */
 :host(:not([visible_])) #zoom-buttons {
-  opacity: 0;
+  opacity: 1;
   transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
 }
 
