#
# skia-fx: restored (the upstream component was pruned from our lean checkout).
# chrome/services/printing:lib pulls this in under enable_print_preview for the
# PWG raster converter. We never call BindPdfToPwgRasterConverter, but the target
# must still compile+link so the PrintingService (PdfNupConverter, used by
# pages-per-sheet) can build. The unit_tests target is dropped.

import("//printing/buildflags/buildflags.gni")

assert(enable_print_preview)

static_library("pwg_encoder") {
  sources = [
    "bitmap_image.cc",
    "bitmap_image.h",
    "pwg_encoder.cc",
    "pwg_encoder.h",
  ]

  deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}
